{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits",
        ":dependencyDashboard",
        ":maintainLockFilesWeekly",
        "group:monorepos",
        "group:recommended",
        "replacements:all",
        "workarounds:all"
    ],
    "timezone": "America/Edmonton",
    "schedule": [
        "after 10pm every weekday",
        "before 5am every weekday",
        "every weekend"
    ],
    "labels": [
        "dependencies",
        "renovate"
    ],
    "assignees": [
        "@djryanj"
    ],
    "reviewers": [
        "@djryanj"
    ],
    "prConcurrentLimit": 5,
    "prHourlyLimit": 2,
    "rebaseWhen": "behind-base-branch",
    "semanticCommits": "enabled",
    "commitMessagePrefix": "chore(deps):",
    "postUpdateOptions": [
        "npmDedupe"
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
            "before 5am on monday"
        ]
    },
    "vulnerabilityAlerts": {
        "labels": [
            "security"
        ],
        "assignees": [
            "@security-team"
        ],
        "reviewers": [
            "@security-team"
        ]
    },
    "packageRules": [
        {
            "description": "Group React ecosystem updates",
            "groupName": "React ecosystem",
            "matchPackagePatterns": [
                "^react",
                "^@types/react"
            ],
            "schedule": [
                "every weekend"
            ]
        },
        {
            "description": "Group Vite and related tooling",
            "groupName": "Vite tooling",
            "matchPackageNames": [
                "vite",
                "@vitejs/plugin-react",
                "@vitejs/plugin-react-swc"
            ]
        },
        {
            "description": "Group testing libraries",
            "groupName": "Testing libraries",
            "matchPackagePatterns": [
                "^@testing-library/",
                "^vitest",
                "^@vitest/",
                "jest",
                "^@types/jest"
            ]
        },
        {
            "description": "Group ESLint and Prettier",
            "groupName": "Linting and formatting",
            "matchPackagePatterns": [
                "^eslint",
                "^@typescript-eslint/",
                "prettier"
            ]
        },
        {
            "description": "Automerge patch and minor updates for dev dependencies",
            "matchDepTypes": [
                "devDependencies"
            ],
            "matchUpdateTypes": [
                "patch",
                "minor"
            ],
            "automerge": true,
            "automergeType": "pr",
            "automergeStrategy": "squash"
        },
        {
            "description": "Automerge patch updates for production dependencies",
            "matchDepTypes": [
                "dependencies"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": true,
            "automergeType": "pr",
            "automergeStrategy": "squash"
        },
        {
            "description": "Pin Docker digests",
            "matchDatasources": [
                "docker"
            ],
            "pinDigests": true
        },
        {
            "description": "Separate major updates for careful review",
            "matchUpdateTypes": [
                "major"
            ],
            "labels": [
                "dependencies",
                "major-update"
            ],
            "automerge": false,
            "schedule": [
                "every weekend"
            ]
        },
        {
            "description": "TypeScript updates require attention",
            "matchPackageNames": [
                "typescript"
            ],
            "labels": [
                "dependencies",
                "typescript"
            ],
            "automerge": false,
            "groupName": "TypeScript"
        },
        {
            "description": "Node.js version updates",
            "matchPackageNames": [
                "node"
            ],
            "labels": [
                "dependencies",
                "node"
            ],
            "automerge": false,
            "enabled": true
        },
        {
            "description": "Disable updates for specific packages if needed",
            "matchPackageNames": [],
            "enabled": false
        }
    ],
    "npm": {
        "minimumReleaseAge": "3 days"
    },
    "stabilityDays": 3,
    "prCreation": "not-pending",
    "ignoreTests": false,
    "ignorePaths": [
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**",
        "**/.vite/**"
    ]
}