{
  "name": "k8s-rbactory-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "check-headers": "node hack/check-file-headers.js",
    "fix-headers": "node hack/check-file-headers.js --fix",
    "check-headers:git": "node hack/check-file-headers.js --git-only",
    "dev": "vite --host 0.0.0.0",
    "dev:no-cluster": "VITE_FEATURE_CLUSTER_BROWSER=false vite --host 0.0.0.0",
    "dev:netlify": "VITE_FEATURE_CLUSTER_BROWSER=false VITE_NETLIFY_DEMO=true vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "build:no-cluster": "tsc && VITE_FEATURE_CLUSTER_BROWSER=false vite build",
    "build:netlify": "tsc && VITE_FEATURE_CLUSTER_BROWSER=false VITE_NETLIFY_DEMO=true vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "axe-playwright",
    "test:yaml-generation": "tsx scripts/test-yaml-generation.ts",
    "test:all": "npm run type-check && npm run lint && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.3",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.49",
    "prettier": "^3.8.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.2",
    "vitest": "^4.0.16"
  }
}
